package practicas1y2;

public class TestAlgebraVectorial {

    public static void main(String[] args) {
        // Instancia de la clase con los métodos de prueba
        AlgebraVectorial algebra = new AlgebraVectorial();

        // Vectores de prueba
        Vector3D v1 = new Vector3D(1.0, 0.0, 0.0);
        Vector3D v2 = new Vector3D(0.0, 1.0, 0.0);
        Vector3D v3 = new Vector3D(2.0, 0.0, 0.0); // Paralelo a v1 (múltiplo por r=2)

        System.out.println("v1 y v2 (por norma/abs): " + algebra.esPerpendicular(v1, v2));
        System.out.println("v1 y v2 (modo 'punto'): " + algebra.esPerpendicular(v1, v2, "punto"));
        System.out.println("v1 y v2 (modo 'pitagoras'): " + algebra.esPerpendicular(v1, v2, "pitagoras"));

        System.out.println("v1 y v3 (por producto cruz): " + algebra.esParalelo(v1, v3));
        System.out.println("v1 y v3 (con escalar r=2.0): " + algebra.esParalelo(v3, v1, 2.0));

        Vector3D proy = algebra.proyAenB(v1, v2);
        System.out.println("Proyección de v1 sobre v2: [" + proy.getA1() + ", " + proy.getA2() + ", " + proy.getA3() + "]");
        
        double comp = algebra.compAenB(v1, v2);
        System.out.println("Componente de v1 en v2: " + comp);
    }
}