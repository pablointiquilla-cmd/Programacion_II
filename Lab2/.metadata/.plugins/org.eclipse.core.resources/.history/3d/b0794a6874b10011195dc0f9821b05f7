package practicas1y2;

public class MiPunto {
	//Atributos
	private double x;
	private double y;
	
	//Constructor sin argumento de coordenadas [0,0]
	public MiPunto() {
		this.x = 0;
		this.y = 0;
	}
	
	//contructor con coordenadas 
	public MiPunto(double x, double y) {
		this.x = x;
		this.y = y;
	}
	
	//getters
	public double getX() {
		return x;
	}

	public double getY() {
		return y;
	}
	
	//distancia 
	public double distancia(double x, double y) {
		double dx = this.x - x;
		double dy = this.y - y;
		return Math.sqrt(dx * dx + dy * dy);
	}

	@Override
	public String toString() {
		return "[x=" + x + ", y=" + y + "]";
	}
	
	
}
