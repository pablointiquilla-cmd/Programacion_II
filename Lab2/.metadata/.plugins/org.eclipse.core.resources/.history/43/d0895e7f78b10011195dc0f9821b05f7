package practicas1y2;

public class Vector3D {
	//Atributos
	private double a1;
	private double a2;
	private double a3;
	
	//constructor
	public Vector3D() {
		this.a1 = 0;
		this.a1 = 0;
		this.a1 = 0;
	}
	public Vector3D(double a1, double a2, double a3) {
		this.a1 = a1;
		this.a2 = a2;
		this.a3 = a3;
	}
	
	//getters
	public double getA1() {
		return a1;
	}
	public double getA2() {
		return a2;
	}
	public double getA3() {
		return a3;
	}
	
	public double suma( Vector3D otro) {
		double nuevoA1 = this.a1 + otro.getA1();
		double nuevoA2 = this.a2 + otro.getA2();
		double nuevoA3 = this.a3 + otro.getA3();
		return new Vector3D(nuevoA1, nuevoA2, nuevoA3)
	}
}
