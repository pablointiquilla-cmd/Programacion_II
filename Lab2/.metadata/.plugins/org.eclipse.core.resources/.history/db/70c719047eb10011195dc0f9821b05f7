package practicas1y2;

public class Vector3D {
	//Atributos
	private double a1;
	private double a2;
	private double a3;
	
	//constructor
	public Vector3D() {
		this(0.0, 0.0, 0.0);
	}
	public Vector3D(double a1, double a2, double a3) {
		this.a1 = a1;
		this.a2 = a2;
		this.a3 = a3;
	}
	
	//getters
	public double getA1() {
		return a1;
	}
	public double getA2() {
		return a2;
	}
	public double getA3() {
		return a3;
	}
	
	//suma de vectores
	public Vector3D suma(Vector3D otro) {
		double nuevoA1 = this.a1 + otro.getA1();
		double nuevoA2 = this.a2 + otro.getA2();
		double nuevoA3 = this.a3 + otro.getA3();
		return new Vector3D(nuevoA1, nuevoA2, nuevoA3);
	}
	
	//resta de vectores
	public Vector3D resta(Vector3D otro) {
		double nuevoA1 = this.a1 - otro.getA1();
		double nuevoA2 = this.a2 - otro.getA2();
		double nuevoA3 = this.a3 - otro.getA3();
		return new Vector3D(nuevoA1, nuevoA2, nuevoA3);
	}
	
	//Multiplicacion de vectores por un escalar
	public Vector3D multiEscalar(double escalar) {
		double nuevoA1 = this.a1 * escalar;
		double nuevoA2 = this.a2 * escalar;
		double nuevoA3 = this.a3 * escalar;
		return new Vector3D(nuevoA1, nuevoA2, nuevoA3);
	}
	
	//Longitud 
	public double longitud() {
		return Math.sqrt(this.a1 * this.a1 + this.a2 * this.a2 + this.a3 * this.a3);
	}
	
	//producto escalar o producto punto
	public double multiEscalar(Vector3D otro) {
		double nuevoA1 = this.a1 * otro.getA1();
		double nuevoA2 = this.a2 * otro.getA2();
		double nuevoA3 = this.a3 * otro.getA3();
		double multiEscalar = nuevoA1 + nuevoA2 + nuevoA3;
		return multiEscalar;
	}
	
	//producto vectorial
	public Vector3D productoVectorial(Vector3D otro) {
		double nuevoA1 = this.a2 * otro.getA3() - this.a3 * otro.getA2();
		double nuevoA2 = this.a3 * otro.getA1( )- this.a1 * otro.getA3();
		double nuevoA3 = this.a1 * otro.getA2() - this.a2 * otro.getA1();
		return new Vector3D(nuevoA1, nuevoA2, nuevoA3);
	}
	@Override
	public String toString() {
		return "Vector3D [a1=" + a1 + ", a2=" + a2 + ", a3=" + a3 + "]";
	}
	
	
}
